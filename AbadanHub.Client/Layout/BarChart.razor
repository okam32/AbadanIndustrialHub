@if (Values.Count == 0)
{
    <p class="muted">داده‌ای برای نمایش وجود ندارد.</p>
}
else
{
    <div class="bars" role="img" aria-label="نمودار میله‌ای توزیع مقادیر">
        @foreach (var item in Values.OrderByDescending(x => x.Count))
        {
            var percentage = maximum == 0 ? 0 : 100d * item.Count / maximum;
            var barStyle = $"width:{percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)}%";
            <div class="bar-row">
                <div class="bar-label"><span>@DisplayName(item.Name)</span><strong>@item.Count</strong></div>
                <div class="bar-track"><div class="bar-fill" style="@barStyle"></div></div>
            </div>
        }
    </div>
}
@code {
    [Parameter] public List<ReportSlice> Values { get; set; } = new();
    private int maximum => Values.Count == 0 ? 0 : Values.Max(x => x.Count);
    private static string DisplayName(string s) => s switch
    {
        "Beginner" => "مقدماتی", "Intermediate" => "متوسط", "Advanced" => "پیشرفته", "Expert" => "خبره",
        "Submitted" => "ثبت‌شده", "UnderReview" => "در حال بررسی", "Referred" => "ارجاع‌شده",
        "InProgress" => "در حال پیگیری", "Resolved" => "رفع‌شده", "Closed" => "مختومه",
        _ => s
    };
}
