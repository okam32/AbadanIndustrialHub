@page "/offerings/{CompanyId:guid}"
<PageTitle>خدمات و محصولات</PageTitle>
<h1>محصولات و خدمات شرکت</h1>
@if (items == null) { <p>در حال دریافت اطلاعات...</p> }
else if (items.Count == 0) { <p>مورد تأییدشده‌ای ثبت نشده است.</p> }
else
{
    <div class="cards two">
        @foreach (var p in items)
        {
            <div class="card"><span class="tag">@(p.Kind == OfferingKind.Service ? "خدمت" : "محصول")</span><h3>@p.Title</h3><p>@p.Description</p></div>
        }
    </div>
}
@code {
    [Parameter] public Guid CompanyId { get; set; }
    private List<OfferingView>? items;
    protected override async Task OnParametersSetAsync()
    {
        try { items = await Api.Get<List<OfferingView>>("api/offerings?companyId=" + CompanyId); }
        catch { items = new(); }
    }
}
